<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catalogatore Minerali</title>
  <style>
    body { display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; background: #f4f4f9; font-family: sans-serif; }
    .card { background: #fff; padding: 2rem; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); text-align: center; max-width: 400px; width: 90%; }
    input[type="file"] { display: none; }
    .btn { padding: 12px 24px; background: #007bff; color: #fff; border-radius: 6px; cursor: pointer; font-weight: bold; display: inline-block; }
    img { max-width: 100%; margin-top: 15px; border-radius: 6px; display: none; }
    #status { margin-top: 15px; font-weight: bold; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Aggiungi Minerale</h2>
    <label for="fotoInput" class="btn">📷 Scatta o Carica Foto</label>
    <input type="file" id="fotoInput" accept="image/*" capture="environment">
    <img id="preview" alt="Anteprima">
    <div id="status"></div>
  </div>

  <script>
    // URL di Google Apps Script integrato automaticamente
    const WEB_APP_URL = "https://script.google.com/macros/s/AKfycbyR6a2rK1_tL138v5Vn-4Qv-0P8r2ZlT29N6e3H1J4mX0v8W9LqD5bK/exec";

    document.getElementById('fotoInput').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const preview = document.getElementById('preview');
      preview.src = URL.createObjectURL(file);
      preview.style.display = 'block';

      const status = document.getElementById('status');
      status.style.color = '#007bff';
      status.textContent = 'Invio in corso...';

      const formData = new FormData();
      formData.append('data', new Date().toISOString().split('T')[0]);

      try {
        const res = await fetch(WEB_APP_URL, { method: 'POST', body: formData });
        const data = await res.json();
        status.style.color = '#28a745';
        status.textContent = `Minerale salvato! Codice: ${data.codice}`;
      } catch (err) {
        status.style.color = '#dc3545';
        status.textContent = 'Errore nel salvataggio.';
      }
    });
  </script>
</body>
</html>